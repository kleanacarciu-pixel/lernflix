# Content-Engine (Phase 1) — alle Keys NUR serverseitig, niemals ins Frontend.
# Kopiere diese Datei zu ".env" und fuelle echte Werte ein.

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 – Video-Produktion (JSON2Video)
JSON2VIDEO_API_KEY=

# Shop / Heft-Verkauf – Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # aus dem Stripe-Webhook-Endpoint (Dashboard)

# E-Mail (Resend) – Kauf-Bestätigung
RESEND_API_KEY=
HEFT_MAIL_FROM=Lerne mit Anna <shop@lernemitanna.de>
HEFT_APP_URL=https://lernflix.lernemitanna.de   # für den Link in der Kauf-Mail

# Supabase anon key (für bestehende Auth-Flows, z. B. Kalender)
SUPABASE_ANON_KEY=
